{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noImplicitAny": false,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["static/app.js", "static/types.d.ts"],
  "exclude": ["target", "node_modules"]
}
